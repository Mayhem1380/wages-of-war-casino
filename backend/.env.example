# Copy this file to backend/.env for local development only.
# Do not commit real secrets. Keep live credentials in your private vault or platform secret manager.
# Production values must be injected at deploy time, not stored in source control.

MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"
CORS_ORIGINS="http://localhost:3000,https://your-domain.example"
FRONTEND_URL="https://your-domain.example"
JWT_SECRET="replace_with_a_long_random_secret"

ADMIN_EMAIL="admin@your-domain.example"
ADMIN_PASSWORD="replace_with_secure_local_admin_password"

STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_ACCOUNT_ID="acct_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_MODE="test"

NOWPAYMENTS_API_KEY="replace_with_live_or_test_key"
NOWPAYMENTS_IPN_SECRET="replace_with_ipn_secret"
NOWPAYMENTS_BASE_URL="https://api.nowpayments.io/v1"

VAULT_API_URL="https://your-vault-host.example/api"
VAULT_API_KEY="replace_with_vault_key"
VAULT_PLATFORM="wages_of_war"
