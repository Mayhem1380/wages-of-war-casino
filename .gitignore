# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files — the production build REQUIRES these, so they must NOT be ignored.
# Do NOT re-add blanket .env ignores: it strips backend/.env (Mongo, JWT, Stripe) and
# frontend/.env from the deployment build context and breaks every publish.
.env.local
.env.development.local
.env.test.local
.env.production.local

# Private vault / secret storage (never commit real credentials)
.secrets/
secrets/
private/
vault/
*.vault
*.key
*.pem
*.p12
*.crt
*.csr
*.pfx
*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Generated package manager files
# Keep lockfiles tracked so CI installs are reproducible.

memory/test_credentials.md

# Mobile development
android-sdk/frontend/node_modules/.cache/default-development/0.pack
frontend/node_modules/.cache/default-development/0.pack
dist/build_artifacts.zip
dist/frontend_build.tgz
frontend/node_modules/.cache/default-development/2.pack
frontend/node_modules/.cache/default-development/3.pack
frontend/node_modules/.cache/default-development/1.pack
wagesofwar_build_20260821165006.tar.gz
frontend/node_modules/.cache/default-development/6.pack
frontend/node_modules/.cache/default-development/5.pack
frontend/node_modules/.cache/default-development/7.pack
frontend/node_modules/.cache/default-development/4.pack
frontend/node_modules/.cache/default-development/4.pack
